    "axios": "^1.12.2",
    "clean-deep": "^3.4.0",
    "clsx": "^2.1.1",
    "concurrently": "^9.1.2",
    "dayjs": "^1.11.13",
    "dotenv": "^16.4.5",
    "express": "^5.2.1",
    "firebase": "^12.13.0",
    "firebase-admin": "^13.10.0",
    "history": "^4.10.1",
    "i18next": "^26.4.2",
    "localforage": "^1.10.0",
    "lodash": "^4.17.21",
    "nodemailer": "^10.0.10",
    "object-hash": "^3.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-i18next": "^17.0.14",
    "react-redux": "^9.2.0",
    "react-router-dom": "^5.3.4",
