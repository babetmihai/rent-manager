{
  "name": "rent-manager",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "./server/lib/pago.js",
  "exports": {
    ".": "./server/lib/pago.js",
    "./pago": "./server/lib/pago.js"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "concurrently --kill-others-on-fail false \"npm run app\" \"npm run server\"",
    "app": "vite --config app/vite.config.mjs --mode development",
    "build": "vite build --config app/vite.config.mjs --mode hosting",
    "server": "node server/index.js",
    "test": "node --test test/*.test.js"
  },
  "license": "MIT",
  "dependencies": {
