# ===========================================
# App
# ===========================================
VITE_APP_VERSION=v1
PORT=3002

# ===========================================
# Firebase (paths relative to repo root)
# Copy firebaseConfig.example.json → firebaseConfig.json
# ===========================================
FIREBASE_CONFIG=firebaseConfig.json
FIREBASE_SERVICE_ACCOUNT=

# ===========================================
# Ticker
# ===========================================
SERVICES_ENABLED=purge,pago_sync,create_tenants,create_tenant,pago_match,match_tenant,bills_mail
WAKE_CATCHUP_SECONDS=120

# ===========================================
# Mail (bill emails; From is the Firebase Auth user)
# ===========================================
SMTP_URL=

# ===========================================
# Ollama (collection-point matching service)
# Pull once: ollama pull llama3.2:3b
# ===========================================
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
