# ===========================================
# App
# ===========================================
VITE_APP_VERSION=v1
PORT=3002
SYNC_PORT=3003

# ===========================================
# Firebase (paths relative to repo root)
# Copy firebaseConfig.example.json → firebaseConfig.json
# ===========================================
FIREBASE_CONFIG=firebaseConfig.json
FIREBASE_SERVICE_ACCOUNT=

# ===========================================
# Ticker
# ===========================================
SERVICES_ENABLED=purge,email
WAKE_CATCHUP_SECONDS=120

# ===========================================
# Mail (Brevo). Messages are sent from the Pago account email.
# ===========================================
BREVO_API_KEY=
